# 必改：部署到公网前请替换为长随机字符串和强密码
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password
DJANGO_SUPERUSER_EMAIL=
APP_API_TOKEN=replace-with-a-long-random-api-token

# Web 与数据库
WEB_PORT=8080
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=jobradar
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-database-password
TIME_ZONE=Asia/Shanghai

# 如果由 HTTPS 反向代理对外提供服务，将以下三项改为 true
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0

# 同步：24 小时制，可自行修改为任意三个时刻
SYNC_ENABLED=true
SYNC_SCHEDULE=08:00,13:00,20:00
RUN_SYNC_ON_STARTUP=true
SYNC_PAGE_SIZE=100
SYNC_TIMEOUT_SECONDS=25
SYNC_RETRIES=3
MISSING_RUNS_TO_INACTIVE=3
NJUST_SCHOOL_CODE=10288
NJUST_BASE_URL=https://njust.91job.org.cn
FETCH_DETAILS=false

# AI 单位研究：宿主机 Worker 负责执行，默认 Codex
AI_RESEARCH_ENABLED=false
AI_RESEARCH_PIPELINE_VERSION=1
AI_RESEARCH_MAX_ATTEMPTS=3
AI_RESEARCH_LEASE_MINUTES=45
AI_RESEARCH_PROVIDER=codex
# Worker 访问地址需与 WEB_PORT 一致
JOB_RADAR_BASE_URL=http://127.0.0.1:8080
# 模型留空使用 CLI 默认；专用设置优先于通用设置
AI_RESEARCH_MODEL=
AI_RESEARCH_CODEX_MODEL=
AI_RESEARCH_CLAUDE_MODEL=
# OpenCode 显式模型必须用 provider/model 格式
AI_RESEARCH_OPENCODE_MODEL=
AI_RESEARCH_TIMEOUT_SECONDS=1800
AI_RESEARCH_CODEX_BIN=codex
AI_RESEARCH_CLAUDE_BIN=claude
AI_RESEARCH_OPENCODE_BIN=opencode
# 留空使用 prompts/employer_research.txt
AI_RESEARCH_PROMPT_FILE=
AI_RESEARCH_KEEP_EVENT_LOG=false

# Gunicorn
WEB_CONCURRENCY=2
WEB_TIMEOUT=60
